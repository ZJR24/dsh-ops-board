{
  "name": "dsh-ops-board",
  "version": "0.1.0",
  "private": true,
  "description": "ops-board 工作台 in Harness: a full-page panel hosting the ledger-driven ops board, with the local board service started and proxied by the host.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "locale/*.json", "README.md", "docs/*", "sync.ps1"],
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "ops-board", "ledger"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
